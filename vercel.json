{
  "rewrites": [
    {
      "source": "/api/transcript",
      "destination": "/api/transcript.js"
    },
    {
      "source": "/transcript",
      "destination": "/transcript.html"
    },
    {
      "source": "/transcript.html",
      "destination": "/transcript.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/transcript",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
